+    /*
+     * Rolls unix forward to the current second.
+     *
+     * On ESP32 this is called from TWO tasks: the Arduino loop (handleTime())
+     * and the AsyncTCP task (/json -> serializeInfo() -> getTimeString() ->
+     * updateLocalTime()). The old body did an unguarded read-modify-write of
+     * fullSecondMillis in a loop. Interleave the two and one update is lost:
+     * fullSecondMillis ends up AHEAD of millis(), the next unsigned subtraction
+     * underflows to ~2^32 ms, and the loop spends 4.29 million iterations
+     * pushing the clock 49 days 17:02:47 into the future. Two of those overnight
+     * is a clock 99 days fast that still ticks at exactly the right rate.
+     *
+     * Three changes: a critical section so the update cannot be lost, a signed
+     * delta so an ahead-of-millis() fullSecondMillis realigns instead of
+     * wrapping, and division instead of a loop so no arithmetic slip can ever
+     * cost 4.29 million iterations again.
+     */
     uint16_t millisecond() {
-      uint32_t ms = millis() - fullSecondMillis;
-      while (ms > 999) {
-        ms -= 1000;
-        fullSecondMillis += 1000;
-        unix++;
+      TOKI_ENTER_CRITICAL();
+      int32_t delta = (int32_t)(millis() - fullSecondMillis);
+      if (delta < 0) {           //ahead of millis(): impossible as elapsed time
+        fullSecondMillis = millis();
+        TOKI_EXIT_CRITICAL();
+        return 0;
+      }
+      uint32_t ms = (uint32_t)delta;
+      if (ms > 999) {
+        uint32_t secs = ms / 1000;
+        ms -= secs * 1000;
+        fullSecondMillis += secs * 1000;
+        unix += secs;
         if (tick == TickT::inactive) tick = TickT::marked; //marked, will be active on next loop
       }
+      TOKI_EXIT_CRITICAL();
       return ms;
     }
 
